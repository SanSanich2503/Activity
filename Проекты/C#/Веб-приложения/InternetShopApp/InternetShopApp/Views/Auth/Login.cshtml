@model LoginForm

@{
    ViewData["Title"] = "Вход в систему";
}

<a asp-action="Register" asp-controller="Auth">Регистрация</a>

<br/><br/>
<form asp-action="Login" asp-controller="Auth" asp-anti-forgery="true">
    <div class="validation" asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <label asp-for="Email">Email:</label>
        <input type="text" asp-for="Email" value="@Model.Email" />
        <span class="validation" asp-validation-for="Email"></span>
    </div>
    <br /><div class="form-group">
        <label asp-for="Password">Пароль:</label>
        <input asp-for="Password" value="@Model.Password" />
        <span class="validation" asp-validation-for="Password"></span>
    </div>
    <br /><input type="submit" class="btn btn-danger" value="Войти" />
</form>

<style>
    textarea {
        width: 450px;
        height: 200px;
        text-align: justify;
    }

    label {
        width: 250px;
    }
</style>