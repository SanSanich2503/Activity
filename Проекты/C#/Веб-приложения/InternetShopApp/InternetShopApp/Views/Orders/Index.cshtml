@using Data.Enums.PurchaseStatuses
@model OrderViewModelList
@inject AuthService AuthService

@{
    ViewData["Title"] = "Заказы";

    var isAdmin = AuthService.IsAdmin();
}

<table center>
    @if (Model.Items.Any())
    {
        <tr>
            <th>Название</th>
            <th style="width:500px;">Описание</th>
            <th>Цена</th>
            <th>Дата покупки</th>
            <th>Дата доставки</th>
            <th></th>
        </tr>
    }
    @{
        foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Title</td>
                <td style="width:500px;text-align:justify;">@item.Description</td>
                <td>@item.Price</td>
                <td>@item.PurchaseDate</td>
                <td>@item.DeliveryDate</td>
                <td>
                    @if (item.StatusEnum == PurchaseStatusEnum.Delivery)
                    {
                        <br/> <br/> <a class="btn btn-danger" id="cancelButton" data-id="@item.Id">Отменить</a>
                    }
                    @if (item.StatusEnum == PurchaseStatusEnum.Completed)
                    {
                        <br/> <br/> <a class="btn btn-danger" id="returnButton" data-id="@item.Id">Вернуть</a>
                    }
                    @if (isAdmin)
                    {
                        <br/> <br/> <a class="btn btn-danger" id="deleteButton" data-id="@item.Id">Удалить</a>
                    }
                </td>
            </tr>
        }
    }
</table>

<br />
<div class="buttons" center>
    @if (Model.PageViewModel.HasPreviousPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageViewModel.PageNumber - 1)"
           class="btn  btn-outline-dark">
            Назад
        </a>
    }
    @if (Model.PageViewModel.HasNextPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageViewModel.PageNumber + 1)"
           class="btn btn-outline-dark">
            Вперед
        </a>
    }
</div>

<style>
    th {
        background-color: deepskyblue;
    }

    td {
        background-color: aliceblue;
    }

    th, td {
        width: 300px;
        border: 3px solid black;
        text-align: center;
    }
</style>

<script type="text/javascript" src="~/js/orders.js"></script>